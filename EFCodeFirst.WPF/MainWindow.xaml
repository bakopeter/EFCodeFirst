<Window x:Class="EFCodeFirst.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Könyvtár Kezelő" Height="700" Width="1200"
        Background="#F5F5F5">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel - Books List -->
        <StackPanel Grid.Column="0" Margin="10">
            <TextBlock Text="KÖNYVEK" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Name="BtnRefreshBooks" Click="BtnRefreshBooks_Click" Width="100" Padding="5" Background="#4CAF50" Foreground="White">Frissítés</Button>
                <Button Name="BtnNewBook" Click="BtnNewBook_Click" Width="100" Padding="5" Margin="5,0,0,0" Background="#2196F3" Foreground="White">Új könyv</Button>
            </StackPanel>

            <DataGrid Name="BooksDataGrid" AutoGenerateColumns="False" Height="300" 
                      CanUserAddRows="False" CanUserDeleteRows="False" MouseDoubleClick="BooksDataGrid_MouseDoubleClick"
                      Background="White" Margin="0,0,0,10">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ISBN" Binding="{Binding ISBN}" Width="100"/>
                    <DataGridTextColumn Header="Cím" Binding="{Binding Title}" Width="150"/>
                    <DataGridTextColumn Header="Szerző" Binding="{Binding Author}" Width="120"/>
                    <DataGridTextColumn Header="Kiadó" Binding="{Binding PublisherName}" Width="100"/>
                    <DataGridTextColumn Header="Oldalak" Binding="{Binding Pages}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="KIADÓK" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Name="BtnRefreshPublishers" Click="BtnRefreshPublishers_Click" Width="100" Padding="5" Background="#4CAF50" Foreground="White">Frissítés</Button>
                <Button Name="BtnNewPublisher" Click="BtnNewPublisher_Click" Width="100" Padding="5" Margin="5,0,0,0" Background="#2196F3" Foreground="White">Új kiadó</Button>
            </StackPanel>

            <DataGrid Name="PublishersDataGrid" AutoGenerateColumns="False" Height="250"
                      CanUserAddRows="False" CanUserDeleteRows="False" MouseDoubleClick="PublishersDataGrid_MouseDoubleClick"
                      Background="White">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="50"/>
                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="200"/>
                    <DataGridTextColumn Header="Könyvek" Binding="{Binding BookCount}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <!-- Right Panel - Form -->
        <StackPanel Grid.Column="1" Margin="10" Background="White" >
            <TextBlock Name="FormTitle" Text="Könyv szerkesztése" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

            <Grid Name="BookFormPanel" Visibility="Visible">
                <StackPanel>
                    <TextBlock Text="ISBN:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtISBN" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Cím:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtTitle" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Szerző:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtAuthor" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Kiadó:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <ComboBox Name="CmbPublisher" Padding="8" Margin="0,0,0,10" Background="#F9F9F9" DisplayMemberPath="Name" SelectedValuePath="ID"/>

                    <TextBlock Text="Nyelv:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtLanguage" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Oldalak:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtPages" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Leírás:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtDescription" Padding="8" Margin="0,0,0,10" Background="#F9F9F9" Height="80" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="BtnSaveBook" Click="BtnSaveBook_Click" Padding="10" Background="#4CAF50" Foreground="White" Width="80">Mentés</Button>
                        <Button Name="BtnDeleteBook" Click="BtnDeleteBook_Click" Padding="10" Margin="5,0,0,0" Background="#F44336" Foreground="White" Width="80">Törlés</Button>
                        <Button Name="BtnCancelBook" Click="BtnCancelBook_Click" Padding="10" Margin="5,0,0,0" Background="#9E9E9E" Foreground="White" Width="80">Mégsem</Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Name="PublisherFormPanel" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="ID:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtPublisherID" Padding="8" Margin="0,0,0,10" IsReadOnly="True" Background="#F9F9F9"/>

                    <TextBlock Text="Név:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtPublisherName" Padding="8" Margin="0,0,0,10" Background="#F9F9F9"/>

                    <TextBlock Text="Könyvek száma:" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Name="TxtPublisherBooks" Padding="8" Margin="0,0,0,10" IsReadOnly="True" Background="#F9F9F9"/>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Name="BtnSavePublisher" Click="BtnSavePublisher_Click" Padding="10" Background="#4CAF50" Foreground="White" Width="80">Mentés</Button>
                        <Button Name="BtnDeletePublisher" Click="BtnDeletePublisher_Click" Padding="10" Margin="5,0,0,0" Background="#F44336" Foreground="White" Width="80">Törlés</Button>
                        <Button Name="BtnCancelPublisher" Click="BtnCancelPublisher_Click" Padding="10" Margin="5,0,0,0" Background="#9E9E9E" Foreground="White" Width="80">Mégsem</Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Name="StatusMessage" Margin="0,20,0,0" TextWrapping="Wrap" Foreground="#333"/>
        </StackPanel>
    </Grid>
</Window>
